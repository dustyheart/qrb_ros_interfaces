AudioInfo audio_info
# Stream operations (eg. "play", "create", "start", "stop", "release", "mute", "get-buildin-sound").
# "play": one touch playback, client doesn't need manage the stream's lifecycle (create/
#  start/stop/release), it handle by Audio Service.
string command
# Stream type (eg. "playback", "record")
string type
# Playback or Record path (e.g. "/tmp/clips.wav" or build-in sound name)
string source
# Playback volume [1~100], default is 80
uint8 volume
# -1:repeat, 0:once
int8 repeat
# The handle indicate the stream created by Audio Service when command is "create",
# client controls (eg. start/mute/stop/release) the stream by it.
uint32 stream_handle
# For streaming playback:
#  The streaming audio data subscribes from a topic, it can be specified using topic_name.
# For record:
#  Whether publish pcm data on a topic when recording (true:yes, false:no).
#  The default topic name is "qrb_audiodata", but it can be specified using topic_name.
bool pub_pcm
string topic_name
# Need to specify it when requesting the "mute" command.
bool mute

# ---- Added in 3.0.0 (all fields below default to the pre-3.0.0 behavior) ----

# Record streams with pub_pcm only, read on "create": fill AudioData.header.stamp
# with the capture time of the first sample of each chunk. false (default):
# AudioData.header.stamp is left zero. Ignored for record-to-file (source set).
bool need_timestamp

# Per-stream overrides, read on "create" only. Empty / 0 = use the node's
# process-wide ROS parameter, i.e. the pre-3.0.0 behavior.
# device: backend device name (record: overrides capture_device, playback:
#  overrides playback_device), e.g.
#  "alsa_input.platform-sound.HiFi__hw_LEMANSEVK_1__source". An unknown name
#  fails "create" with error_code "device_unavailable".
string device
# fragment_duration_ms: record streams only (overrides
#  capture_fragment_duration_ms): requested duration of each AudioData chunk
#  in milliseconds. Ignored for playback (playback_buffer_duration_ms stays a
#  node parameter). Out-of-range values fail "create" with error_code
#  "invalid_config".
uint32 fragment_duration_ms
---
bool success
# The handle indicate the stream created by Audio Service when command is "create".
uint32 stream_handle
string[] buildin_sound_name

# ---- Added in 3.0.0 ----

# Machine-readable failure category, empty when success is true. One of:
#  "invalid_config", "device_unavailable", "unsupported_format",
#  "backend_init_failed", "stream_state_conflict", "processor_init_failed",
#  "processor_process_failed", "resource_exhausted", "internal_error",
#  "invalid_handle", "unknown_command".
# Clients must treat unknown values as "internal_error" (the list may grow).
string error_code
# Human-readable detail for logs / UI, e.g. "capture device 'x' not found;
# available: ...". Not stable across versions; do not parse.
string error_message
