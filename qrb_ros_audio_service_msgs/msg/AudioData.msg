# PCM audio data of a stream created via AudioRequest.

# Bits of `flags` (added in 3.0.0). Receivers must ignore unknown bits.
# Audio was lost inside the service immediately BEFORE this chunk (backend
# overrun, internal queue overflow): the stream timeline is discontinuous
# between the previous chunk and this one. header.stamp (if enabled) is still
# correct for this chunk.
uint32 FLAG_DROPPED = 1
# This chunk carries silence generated by the service (stream muted, or a gap
# filled because the device delivered nothing), not captured audio.
uint32 FLAG_SILENCE = 2
# A capture processing chain (NS/VAD/AEC) is configured for the stream but did
# NOT run on this chunk (a processor failed or was bypassed): `data` is raw.
uint32 FLAG_BYPASSED = 4

# Added in 3.0.0.
# header.stamp: capture time of the FIRST sample frame in `data`, on the
#  publishing node's ROS clock. All zero when the stream was created without
#  AudioRequest.need_timestamp, or when no valid capture time is available
#  for this chunk.
# header.frame_id: TF frame of the capture device, taken from a node parameter
#  (empty by default).
std_msgs/Header header

# The handle of the stream this data belongs to (AudioRequest.stream_handle).
uint32 stream_handle
# Raw PCM payload (format given by the stream's AudioInfo).
uint8[] data

# ---- Added in 3.0.0 ----

# Per-stream chunk counter: 0 for the first chunk published after "create",
# +1 for every published chunk, not reset by stop/start. A gap seen by a
# subscriber means chunks were lost in transport (DDS/QoS); loss inside the
# service is reported by FLAG_DROPPED instead.
uint64 sequence
# Bitwise OR of the FLAG_* constants above; 0 = normal captured chunk.
uint32 flags

# For streaming playback (AudioData published by a client to the service),
# header, sequence and flags are ignored by the service.
